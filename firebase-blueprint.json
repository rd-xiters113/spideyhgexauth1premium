{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered account profile with subscription and quota enforcement.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "plan": { "type": "string", "enum": ["FREE", "PREMIUM"] },
        "keysUsed": { "type": "number" },
        "maxKeysQuota": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin", "superadmin"] },
        "subscriptionExpiresAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "createdAt", "accountStatus", "plan", "keysUsed", "maxKeysQuota", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator role record authorizing management panel access.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "addedAt": { "type": "string", "maxLength": 64 },
        "addedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "email", "role", "addedAt", "addedBy"]
    },
    "Application": {
      "title": "Application",
      "description": "Customer managed software product with isolated licensing configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "version": { "type": "string", "maxLength": 32 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 256 },
        "appSecret": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "hwidLockEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "version", "ownerId", "ownerEmail", "appSecret", "status", "hwidLockEnabled", "createdAt", "updatedAt"]
    },
    "LicenseKey": {
      "title": "LicenseKey",
      "description": "Cryptographic license key or credential license for software activation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "key": { "type": "string", "maxLength": 64 },
        "appId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["key", "credentials"] },
        "durationDays": { "type": "number" },
        "status": { "type": "string", "enum": ["unused", "active", "expired", "banned"] },
        "hwid": { "type": "string", "maxLength": 128 },
        "maxDevices": { "type": "number" },
        "notes": { "type": "string", "maxLength": 256 },
        "username": { "type": "string", "maxLength": 64 },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "activatedAt": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "lastUsedAt": { "type": "string", "maxLength": 64 },
        "bannedReason": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "key", "appId", "ownerId", "type", "durationDays", "status", "maxDevices", "createdAt"]
    },
    "Credential": {
      "title": "Credential",
      "description": "Application client user credentials for end-user software authentication.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "appId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "durationDays": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended", "expired"] },
        "deviceLimit": { "type": "number" },
        "currentHwid": { "type": "string", "maxLength": 128 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "appId", "ownerId", "username", "passwordHash", "durationDays", "status", "deviceLimit", "createdAt"]
    },
    "PremiumAllowlist": {
      "title": "PremiumAllowlist",
      "description": "Admin approved email allowlist for unlocking premium subscriptions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "plan": { "type": "string", "enum": ["PREMIUM"] },
        "durationDays": { "type": "number" },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["active", "revoked", "expired"] }
      },
      "required": ["id", "email", "plan", "durationDays", "approvedBy", "approvedAt", "status"]
    },
    "UpgradeRequest": {
      "title": "UpgradeRequest",
      "description": "User submitted manual upgrade request awaiting admin review and verification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "requestedPlan": { "type": "string", "maxLength": 64 },
        "duration": { "type": "string", "maxLength": 64 },
        "paymentReference": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "reviewedAt": { "type": "string", "maxLength": 64 },
        "reviewedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "userId", "email", "requestedPlan", "duration", "status", "createdAt"]
    },
    "Reseller": {
      "title": "Reseller",
      "description": "Application owner appointed reseller with key generation allowances.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "appId": { "type": "string", "maxLength": 128 },
        "resellerUsername": { "type": "string", "maxLength": 64 },
        "resellerEmail": { "type": "string", "maxLength": 256 },
        "keysQuota": { "type": "number" },
        "keysUsed": { "type": "number" },
        "permissions": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerId", "appId", "resellerUsername", "resellerEmail", "keysQuota", "keysUsed", "status", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Security audit and operation log entries for transparency.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 256 },
        "actorRole": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 100 },
        "targetType": { "type": "string", "maxLength": 64 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "ipAddress": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "actorId", "actorEmail", "action", "targetType", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with plan details and quota."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Super admin and admin authorization records."
    },
    "/applications/{appId}": {
      "schema": "Application",
      "description": "Registered applications owned by developers."
    },
    "/license_keys/{keyId}": {
      "schema": "LicenseKey",
      "description": "License keys generated under developer applications."
    },
    "/credentials/{credentialId}": {
      "schema": "Credential",
      "description": "User/password accounts registered for applications."
    },
    "/premium_allowlist/{allowlistId}": {
      "schema": "PremiumAllowlist",
      "description": "Admin-maintained allowlist for email-based premium unlocks."
    },
    "/upgrade_requests/{requestId}": {
      "schema": "UpgradeRequest",
      "description": "Manual upgrade requests pending admin approval."
    },
    "/resellers/{resellerId}": {
      "schema": "Reseller",
      "description": "Application resellers appointed by app owners."
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Audit trail of security and licensing actions."
    }
  }
}
